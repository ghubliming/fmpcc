<mujoco model="UAV Avoiding-Pillars Scene (scale 36)">
  <!-- The D3IL obstacle-avoidance field mapped by X = 36 (y_a - 0.035), Y = -36 (x_a - 0.5): six pillars, finish line X = 11.34. -->
  <include file="../quadrotor_modified.xml"/>
  <compiler meshdir="../assets" texturedir="../assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="32" height="32"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"/>
    <material name="pillar" rgba="0.85 0.55 0.25 1"/>
    <material name="finish" rgba="0 1 0 0.3"/>
  </asset>

  <worldbody>
    <light name="overhead" pos="0 0 8" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="16.1 16.1 0.05" material="groundplane"/>

    <!-- 6 pillars = the avoiding obstacles (l1 / l2_top l2_bottom / l3_top l3_mid l3_bottom), scaled x36 -->
    <geom name="pillar_l1_obs" type="cylinder" pos="-4.8600 -0.0000 1.000" size="1.0800 1.000" material="pillar"/>
    <geom name="pillar_l2_top_obs" type="cylinder" pos="1.6200 2.7000 1.000" size="0.9000 1.000" material="pillar"/>
    <geom name="pillar_l2_bottom_obs" type="cylinder" pos="1.6200 -2.7000 1.000" size="0.9000 1.000" material="pillar"/>
    <geom name="pillar_l3_top_obs" type="cylinder" pos="8.1000 5.4000 1.000" size="0.9000 1.000" material="pillar"/>
    <geom name="pillar_l3_mid_obs" type="cylinder" pos="8.1000 -0.0000 1.000" size="0.9000 1.000" material="pillar"/>
    <geom name="pillar_l3_bottom_obs" type="cylinder" pos="8.1000 -5.4000 1.000" size="0.9000 1.000" material="pillar"/>

    <!-- finish line (visual only, no collision): avoiding y_a = 0.35 -> world X = 11.34 -->
    <geom name="finish_line" type="box" pos="11.3400 0 0.01" size="0.02 11.300 0.005"
          material="finish" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
